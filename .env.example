# Banco de Dados
DB_NAME=smartfood
DB_USER=smartfood
DB_PASSWORD=smartfood123
DB_HOST=db
DB_PORT=5432

# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# IA (Groq) - a chave vive apenas no servidor
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
INTERNAL_API_URL=http://backend:8000/api/v1

# Cerebro (vault Obsidian lido pela IA)
# Caminho do vault. Vazio = usa frontend/cerebro (padrao).
CEREBRO_DIR=
CEREBRO_CONTA_PADRAO=smartfood-demo

# WebSocket da cozinha visto pelo navegador (vazio = deriva de NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_WS_URL=

# Senha do usuario criado por `manage.py seed_demo`
DEMO_PASSWORD=
